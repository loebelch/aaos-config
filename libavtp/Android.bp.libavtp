package {
    default_applicable_licenses: ["external_libavtp_license"],
}

license {
    name: "external_libavtp_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-BSD"],
    license_text: ["LICENSE"],
}

cc_defaults {
    name: "libavtp_defaults",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}

cc_library {
    name: "libavtp",
    defaults: ["libavtp_defaults"],

    // In Vendor- und System-Partition nutzbar (Audio-HAL, EVS, Vendor-Daemons)
    vendor_available: true,
    product_available: true,
    recovery_available: false,
    host_supported: false,

    srcs: [
        "src/avtp.c",
        "src/avtp_aaf.c",
        "src/avtp_crf.c",
        "src/avtp_cvf.c",
        "src/avtp_rvf.c",
        "src/avtp_ieciidc.c",
        "src/avtp_stream.c",
        "src/avtp_vsf_stream.c",
    ],

    local_include_dirs: ["include", "src"],
    export_include_dirs: ["include"],

    stl: "none",

    // aus meson.build: version 0.2.0
    stem: "libavtp",
}
